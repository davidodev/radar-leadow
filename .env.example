# --- baza ---
# Pasuje do docker-compose.yml. Jesli masz juz Postgresa na 5432,
# ustaw RADAR_DB_PORT=5433 i zmien port tutaj na ten sam.
DATABASE_URL=postgres://radar:radar@localhost:5432/radar
# RADAR_DB_PORT=5433

# --- powiadomienia ---
# BotFather -> /newbot ; chat id: napisz do bota i wejdz na
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CEIDG (etap 3) ---
# Klucz JWT: biznes.gov.pl -> wniosek o dostep do Hurtowni Danych,
# logowanie Profilem Zaufanym / mObywatelem. Bezplatny, przychodzi mailem.
CEIDG_TOKEN=
# v3 jest w dokumentacji dla integratorow; jesli Twoj klucz dziala tylko na v2,
# zmien na https://dane.biznes.gov.pl/api/ceidg/v2
CEIDG_BASE=https://dane.biznes.gov.pl/api/ceidg/v3

# --- PageSpeed Insights (etap 2) ---
# Klucz darmowy, Google Cloud Console -> wlacz "PageSpeed Insights API".
# Bez klucza limit jest znacznie nizszy i nieudokumentowany.
PSI_KEY=

# --- zasieg ---
# NUTS wojewodztwa: PL61 = kujawsko-pomorskie
PROVINCE_NUTS=PL61
PROVINCE_NAME=kujawsko-pomorskie
# miasta liczone jako "lokalne" (mozliwa wizyta osobista)
LOCAL_CITIES="Torun,Bydgoszcz,Wloclawek,Grudziadz,Inowroclaw,Brodnica,Chelmno,Chelmza,Naklo nad Notecia,Swiecie,Rypin,Golub-Dobrzyn,Aleksandrow Kujawski,Ciechocinek,Lipno,Znin,Mogilno,Solec Kujawski,Koronowo,Tuchola,Sepolno Krajenskie,Wabrzezno,Radziejow"

# --- higiena ---
# Wartosci ze spacjami i nawiasami sa w cudzyslowach, zeby dalo sie zrobic
# `set -a; . ./.env` w shellu. dotenv radzi sobie z obiema formami.
# minimalny odstep miedzy zapytaniami do Useme (robots.txt: crawl-delay 10)
USEME_DELAY_MS=11000
USER_AGENT="RadarLeadow/0.1 (+https://davido.pl; kontakt@davido.pl)"
